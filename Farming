    snapButton.MouseButton1Click:Connect(function() waitLoop() end)

    local dragging = false
    local dragInput, mousePos, btnPos

    snapButton.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            mousePos = input.Position
            btnPos = snapButton.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)

    snapButton.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    snapInputChangedConn = UserInputService.InputChanged:Connect(function(input)
        if not dragging or input ~= dragInput then return end
        local delta = input.Position - mousePos
        snapButton.Position = UDim2.new(
            btnPos.X.Scale, btnPos.X.Offset + delta.X,
            btnPos.Y.Scale, btnPos.Y.Offset + delta.Y
        )
    end)
end

