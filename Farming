-- Variables
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer
local autofarmActivo = false
local metodoSeleccionado = "Velocidad" -- Por defecto usa el método seguro

-- Crear ventana
local Window = Library:CreateWindow({
    Title = "Autofarm Plantas",
    Folder = "ObsidianFarm",
    Size = UDim2.new(0, 450, 0, 250)
})

local Tab = Window:CreateTab("Principal")

-- Menú desplegable para elegir método
Tab:CreateDropdown({
    Name = "Método de Teletransporte",
    Description = "Elige 'Velocidad' si el juego te regresa al hacer TP. Usa 'Anclar' si el de velocidad no funciona.",
    Options = {"Velocidad", "Anclar"},
    CurrentOption = "Velocidad",
    Callback = function(option)
        metodoSeleccionado = option
    end
})

-- Botón de Autofarm
Tab:CreateToggle({
    Name = "Autofarm Plantas",
    Description = "Inicia el bucle para recorrer las plantas.",
    DefaultValue = false,
    Callback = function(state)
        autofarmActivo = state
        
        if state then
            task.spawn(function()
                while autofarmActivo do
                    local character = LocalPlayer.Character
                    if character and character:FindFirstChild("HumanoidRootPart") and character:FindFirstChild("Humanoid") then
                        local hrp = character.HumanoidRootPart
                        local hum = character.Humanoid
                        
                        for i, coord in ipairs(PlantasCoords) do
                            if not autofarmActivo then break end
                            
                            if metodoSeleccionado == "Velocidad" then
                                -- MÉTODO 1: Caminar volando hacia la coordenada (Bypass anti-tp)
                                local distancia = (hrp.Position - coord).Magnitude
                                local tiempo = distancia / 150 -- Velocidad de 150 (puedes subirla si quieres más rápido)
                                local tiempoInicio = tick()
                                
                                while tick() - tiempoInicio < tiempo and autofarmActivo do
                                    local alpha = (tick() - tiempoInicio) / tiempo
                                    local nuevaPos = hrp.Position:Lerp(coord, alpha)
                                    -- Mueve el personaje sin disparar el anti-cheat
                                    hrp.CFrame = CFrame.new(nuevaPos, coord)
                                    RunService.Stepped:Wait()
                                end
                                hrp.CFrame = CFrame.new(coord)
                                
                            elseif metodoSeleccionado == "Anclar" then
                                -- MÉTODO 2: Anclar el personaje para forzar el TP
                                hrp.Anchored = true
                                task.wait(0.1)
                                hrp.CFrame = CFrame.new(coord)
                                task.wait(0.4) -- Tiempo para que el juego registre la posición
                                hrp.Anchored = false
                            end
                            
                            task.wait(0.2) -- Pausa antes de ir a la siguiente planta
                        end
                    end
                    task.wait(0.1)
                end
            end)
        end
    end
})
