local autoHealEnabled = false
local HEALTH_THRESHOLD = 75
local healBusy = false

local function stopAnimations()
    local char = LocalPlayer.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    local animator = hum:FindFirstChildOfClass("Animator")
    if not animator then return end
    for _, track in pairs(animator:GetPlayingAnimationTracks()) do track:Stop(0) end
end

local function getHealthTool()
    local backpack = LocalPlayer:FindFirstChild("Backpack")
    if backpack then
        for _, tool in pairs(backpack:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("HealthRestoreAmount") then return tool end
        end
    end
    local char = LocalPlayer.Character
    if char then
        for _, tool in pairs(char:GetChildren()) do
            if tool:IsA("Tool") and tool:GetAttribute("HealthRestoreAmount") then return tool end
        end
    end
    return nil
end

local function useHealthTool(tool)
    if healBusy then return end
    healBusy = true
    local char = LocalPlayer.Character
    if not char then healBusy = false; return end
    local oldTool = char:FindFirstChildOfClass("Tool")
    tool.Parent = char
    task.wait()
    tool:Activate()
    stopAnimations()
    task.wait(0.25)
    if oldTool and oldTool.Parent == char then oldTool.Parent = LocalPlayer.Backpack end
    healBusy = false
end

